# Developer Python environments and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Deliberate operator scratch directory; production must never write here
/temp/

# Editor and operating-system residue
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# Local secrets: defense in depth, not permission to store runtime data here
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
/subsystems/notifications/firebase-service-account.json
/subsystems/security/security_state.json
/subsystems/matter/chip_tool_storage/
/subsystems/matter/chip_tool_subscription_storage/

# Android/Gradle developer build products
.gradle/
**/build/
local.properties

# Deliberate editable graphics and local favicon references
*.ufo
*.ufo/
*.psd
/static/img/favicons/FLASK_ROUTES.txt
/static/img/favicons/HEAD_SNIPPET.txt
